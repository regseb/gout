{
  "name": "gout",
  "version": "0.14.1",
  "description": "Agrégateur d'Internet (flux RSS et tout le reste).",
  "keywords": [
    "gout",
    "aggregator",
    "feed",
    "news",
    "reader",
    "rss",
    "atom",
    "scraper"
  ],
  "homepage": "https://github.com/regseb/gout#readme",
  "bugs": {
    "url": "https://github.com/regseb/gout/issues",
    "email": "regseb@gmail.com"
  },
  "license": "MIT",
  "author": "Sébastien Règne <regseb@gmail.com> (https://github.com/regseb)",
  "funding": [
    "https://buymeacoffee.com/regseb",
    "https://www.paypal.me/sebastienregne"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regseb/gout.git"
  },
  "type": "module",
  "scripts": {
    "lint": "metalint",
    "lint:fix": "metalint --fix",
    "lint:types": "tsc --project .tsconfig_lint.json",
    "test": "npm run test:coverage",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:coverage": "stryker run",
    "jsdocs": "typedoc --tsconfig .tsconfig_jsdocs.json",
    "serve": "http-server -p6007 -c-1 --cors",
    "extension:chromium": "web-ext run --source-dir src/extension/chromium/ --target chromium",
    "extension:firefox": "web-ext run --source-dir src/extension/firefox/ --target firefox-desktop",
    "build:chromium": "web-ext build --source-dir src/extension/chromium/ --artifacts-dir build/chromium/ --overwrite-dest",
    "build:firefox": "web-ext build --source-dir src/extension/firefox/ --artifacts-dir build/firefox/ --overwrite-dest",
    "clean": "node .script/clean.js"
  },
  "devDependencies": {
    "@biomejs/js-api": "6.1.0",
    "@biomejs/wasm-nodejs": "2.6.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@prantlf/jsonlint": "17.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@secretlint/secretlint-rule-github": "13.1.0",
    "@secretlint/secretlint-rule-npm": "13.1.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.6",
    "addons-linter": "10.15.0",
    "eslint": "10.14.0",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.2",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "htmlhint": "1.9.0",
    "http-server": "14.1.1",
    "markdownlint": "0.42.0",
    "metalint": "0.22.1",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.10",
    "purgecss": "8.0.0",
    "secretlint": "13.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-order": "8.1.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "web-ext": "10.8.0",
    "yaml-lint": "1.7.0"
  },
  "engines": {
    "node": ">=26.5.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "private": true
}
